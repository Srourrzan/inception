events {
	   worker_connections 1024;
}

http {
	 include /etc/nginx/mime.types;
	 default_type application/octet-stream;

    server {
        listen 80;
        server_name ${DOMAIN_NAME};
        return 301 https://$host$request_uri;
}

	 server {

	   # Tell nginx to listen on port 443 and expect SSL/TLS traffic
	   listen 443 ssl;

	   # Tell nginx to only respond to requests for this specific domain
	   server_name ${DOMAIN_NAME};

	   # Point to public certificate and private key file
	   # TLS cannot work without them
	   ssl_certificate /etc/nginx/ssl/${DOMAIN_NAME}.crt;
	   ssl_certificate_key /etc/nginx/ssl/${DOMAIN_NAME}.key;

	   # Explicity disable older insecure protocols (TLSv1.0, TLSv1.1, and SSLv3).
	   ssl_protocols TLSv1.2 TLSv1.3;

	   # Tell nginx where WordPress files are located
	   root /var/www/html;  # to find `index.php` or static files
	   index index.php index.html;

	   # handle normal requests
	   location / {
	   			try_files $uri $uri/ /index.php?$query_string;
	   }

	   # Catch `.php` requests and forward them to WordPress
	   # connect NGINX to PHP-FPM
	   location ~ \.php$ {
	   			include fastcgi_params;

				# Forward to the 'wordpress' service on port 9000
				fastcgi_pass wordpress:9000;
				# Tells PHP-FPM exactly which file to execute
				fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
				fastcgi_param SCRIPT_NAME $fastcgi_script_name;
				
	   			 }
	   }
}












